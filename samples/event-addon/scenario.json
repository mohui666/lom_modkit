{
  "schema": 1,
  "tasks": [
    {
      "id": "delivery",
      "name": "替同门送信",
      "initial": "locked",
      "states": [
        "locked",
        "available",
        "accepted",
        "completed",
        "declined"
      ],
      "transitions": [
        {
          "from": "locked",
          "to": "available",
          "when": {
            "source": "time",
            "key": "month",
            "op": "eq",
            "value": 7
          }
        }
      ]
    }
  ],
  "events": [
    {
      "id": "july_letter",
      "name": "七月来信",
      "trigger": "auto",
      "script": "meeting",
      "once": true,
      "check": "month",
      "priority": 0,
      "chance": 30,
      "weight": 1,
      "when": {
        "all": [
          {
            "source": "time",
            "key": "month",
            "op": "eq",
            "value": 7
          },
          {
            "source": "task",
            "key": "delivery",
            "op": "eq",
            "value": "available"
          }
        ]
      },
      "outcomes": {
        "completed": {},
        "accepted": {
          "tasks": {
            "delivery": "accepted"
          }
        },
        "declined": {
          "tasks": {
            "delivery": "declined"
          }
        }
      }
    },
    {
      "id": "practice_chat",
      "name": "练功闲谈",
      "trigger": "position",
      "script": "practice",
      "once": false,
      "check": "action",
      "priority": 0,
      "chance": 100,
      "weight": 30,
      "when": {
        "all": [
          {
            "any": [
              { "source": "time", "key": "year", "op": "gt", "value": 2 },
              {
                "all": [
                  { "source": "time", "key": "year", "op": "eq", "value": 2 },
                  { "source": "time", "key": "month", "op": "gt", "value": 3 }
                ]
              },
              {
                "all": [
                  { "source": "time", "key": "year", "op": "eq", "value": 2 },
                  { "source": "time", "key": "month", "op": "eq", "value": 3 },
                  { "source": "time", "key": "stage", "op": "ge", "value": 1 }
                ]
              }
            ]
          },
          {
            "any": [
              { "source": "time", "key": "year", "op": "lt", "value": 3 },
              {
                "all": [
                  { "source": "time", "key": "year", "op": "eq", "value": 3 },
                  { "source": "time", "key": "month", "op": "lt", "value": 2 }
                ]
              },
              {
                "all": [
                  { "source": "time", "key": "year", "op": "eq", "value": 3 },
                  { "source": "time", "key": "month", "op": "eq", "value": 2 },
                  { "source": "time", "key": "stage", "op": "le", "value": 3 }
                ]
              }
            ]
          }
        ]
      },
      "outcomes": {
        "completed": {
          "variables": {
            "practice_visits": {
              "op": "add",
              "value": 1
            }
          },
          "actions": [
            {
              "type": "stat",
              "key": "money",
              "op": "add",
              "value": 5
            }
          ]
        }
      },
      "position": "Center",
      "pool": "training"
    },
    {
      "id": "ordinary_training",
      "name": "平常练功",
      "trigger": "position",
      "script": "ordinary",
      "once": false,
      "check": "action",
      "priority": 0,
      "chance": 100,
      "weight": 70,
      "when": {
        "all": []
      },
      "outcomes": {
        "completed": {
          "variables": {},
          "tasks": {}
        }
      },
      "position": "Center",
      "pool": "training"
    },
    {
      "id": "deliver_letter",
      "name": "山门交信",
      "trigger": "position",
      "script": "delivery",
      "once": true,
      "check": "stage",
      "priority": 0,
      "chance": 100,
      "weight": 1,
      "when": {
        "source": "task",
        "key": "delivery",
        "op": "eq",
        "value": "accepted"
      },
      "outcomes": {
        "completed": {
          "tasks": {
            "delivery": "completed"
          },
          "actions": [
            {
              "type": "stat",
              "key": "money",
              "op": "add",
              "value": 50
            }
          ]
        }
      },
      "position": "Door"
    },
    {
      "id": "iron_fist_visit",
      "name": "二年三月起拜访铁拳门",
      "trigger": "story_entry",
      "target": "section_01_free_03",
      "from": "section_01_free_start_02",
      "script": "iron_fist_visit",
      "once": true,
      "check": "action",
      "priority": 0,
      "chance": 100,
      "weight": 1,
      "when": {
        "any": [
          { "source": "time", "key": "year", "op": "gt", "value": 2 },
          {
            "all": [
              { "source": "time", "key": "year", "op": "eq", "value": 2 },
              { "source": "time", "key": "month", "op": "gt", "value": 3 }
            ]
          },
          {
            "all": [
              { "source": "time", "key": "year", "op": "eq", "value": 2 },
              { "source": "time", "key": "month", "op": "eq", "value": 3 },
              { "source": "time", "key": "stage", "op": "ge", "value": 1 }
            ]
          }
        ]
      },
      "outcomes": {
        "completed": {}
      }
    }
  ]
}
