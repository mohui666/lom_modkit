<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标框架与现有插件 MortalInstantWin 一致（net48），BepInEx 6 Mono + Unity 2020.3 实测可加载 -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MortalModHost</AssemblyName>
    <RootNamespace>MortalModHost</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <!-- 游戏目录路径（只读引用，绝不写入） -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\LegendOfMortal</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 让 dotnet 8 SDK 能编译 net48（自带 .NET Framework 参考程序集） -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- OGG 解码：纯托管、无额外 native 依赖，供自定义音频走 winmm 输出 -->
    <PackageReference Include="NVorbis" Version="0.8.6" />
  </ItemGroup>

  <!-- test/ 是离线冒烟测试工程，别编进插件 DLL -->
  <ItemGroup>
    <Compile Remove="test/**/*.cs" />
  </ItemGroup>

  <!-- net48 默认引用集不含压缩程序集，ZipArchive 需要显式引用 -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- 以下引用全部 Private=false：游戏目录已自带这些 DLL，不随产物拷贝 -->
  <ItemGroup>
    <!-- BepInEx 6 核心（插件特性、日志、Paths） -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BepInEx 6 Unity Mono 宿主（BaseUnityPlugin 在这里） -->
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony（下轮 hook 用，本轮仅引用备着） -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity 引擎程序集 -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏程序集：Mortal.Core（SceneController / PlayerStatManagerData / GameOver/EndGame 控制器 / MenuToggleButton） -->
    <Reference Include="Mortal.Core">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏程序集：LuaManager（剧情演出宿主） -->
    <Reference Include="Mortal.Story">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Story.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Gameplay 高层 combat：仅观察原版胜负并让 MOD lose 分支返回 Story。 -->
    <Reference Include="Mortal.Combat">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Combat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Battle">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Battle.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏程序集：FreePositionData / PositionController（自由模式位置触发器） -->
    <Reference Include="Mortal.Free">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Free.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- OBB.Framework：EnumUtils.TryParseByStringValue（when_affinity 角色契约 id → RelationshipStatType） -->
    <Reference Include="OBB.Framework">
      <HintPath>$(GameDir)\Mortal_Data\Managed\OBB.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.UI：Text 组件（GameOver/End 官方画面的标题/描述文本写入） -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Font.CreateDynamicFontFromOSFont（披露芯片在找不到游戏字体时回退系统中文字体） -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.UIModule：CanvasGroup（GameOver 描述容器/按钮画布 fade 目标） -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.ImageConversionModule：Texture2D.LoadImage（结局卡背景图 PNG/JPG 解码） -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 自定义用户音频：AudioSource / AudioClip / UnityWebRequestMultimedia -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- LeanLocalization（契约 §A：texts.json 台词注册进官方本地化表，GetStoryText 已读变黄能力） -->
    <Reference Include="LeanLocalization">
      <HintPath>$(GameDir)\Mortal_Data\Managed\LeanLocalization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Fungus（LuaEnvironment；MoonSharp.Interpreter 已 ILRepack 合进本 DLL） -->
    <Reference Include="Fungus">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Fungus.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 新 InputSystem（本游戏启用了新输入系统，旧 UnityEngine.Input 运行时会抛异常，热键判定必须走这里） -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IMGUI（mod 菜单窗口）与 InputLegacy（仅为编译期解析 KeyboardShortcut 里的 KeyCode 枚举，运行时绝不调旧 Input API） -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
